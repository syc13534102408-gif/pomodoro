{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pine-pomodoro-reminders",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "durable_objects": {
    "bindings": [
      { "name": "TIMER", "class_name": "TimerReminder" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TimerReminder"] }
  ]
}
